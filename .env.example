# ── Pflicht für Weg B (YouTube) und Weg C (Reels/Dateien) ────────────────────
# Fal-API-Key: https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: anderes video-fähiges Modell über den Fal-Router
# FAL_VIDEO_MODEL=google/gemini-2.5-flash

# ── Nur für Weg C (Instagram-Reels / lokale Videodateien) ────────────────────
# Supabase-Projekt mit einem Storage-Bucket (public read) — siehe SETUP.md
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VIDEO_INGEST_BUCKET=research-videos

# ── Optional: direkter Google-Weg statt Fal ──────────────────────────────────
# VIDEO_INGEST_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
